# Application Configuration
PROJECT_NAME="ShopOps Agent API"
ENVIRONMENT=development
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Store Owner Authorization & Security
OWNER_EMAIL=owner@example.com
DEV_AUTH_TOKEN=shopops-dev-owner-token
ENABLE_DEV_AUTH=true

# Supabase Configuration (Primary Database & Authentication)
# Obtain these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google Gemini API Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Legacy Firebase Admin Configuration (Optional fallback)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
