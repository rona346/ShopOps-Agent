# Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000

# Supabase Web Client Configuration (Required for Supabase Auth)
# Obtain these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# SECURITY NOTICE:
# NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET in frontend .env or any VITE_ variable!
# Those privileged secrets must only be stored in backend/.env or the Render dashboard.

# Legacy Firebase Web App Client Configuration (Optional fallback)
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
